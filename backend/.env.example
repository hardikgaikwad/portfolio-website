# ═══════════════════════════════════════════════════════════
# Portfolio Backend — Production Environment Configuration
# ═══════════════════════════════════════════════════════════

# Core Django Security
SECRET_KEY=your-super-long-random-secret-key-at-least-50-characters
DEBUG=False
ALLOWED_HOSTS=api.example.com,localhost,127.0.0.1

# Managed PostgreSQL Connection URL (from Neon, Render, or Railway)
# Format: postgresql://user:password@hostname:5432/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-something.region.neon.tech/portfolio_db?sslmode=require

# CORS & CSRF (Include both apex domain and www subdomain)
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com,https://api.example.com

# GitHub Synchronization (Optional personal access token for higher rate limits)
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere



# JWT Security
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Upload Limits
MAX_UPLOAD_SIZE_MB=10
